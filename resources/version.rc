            VALUE "OriginalFilename", "winprofile-admin.exe\0"
            VALUE "ProductName", "WinProfile Suite\0"
            VALUE "ProductVersion", "2026.0819.00\0"
        END
    END
    BLOCK "VarFileInfo"
