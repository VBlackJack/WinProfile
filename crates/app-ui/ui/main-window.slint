import { DraculaTheme } from "theme.slint";
import { Button, CheckBox, LineEdit, ListView, ProgressIndicator } from "std-widgets.slint";

export struct ProfileEntry {
    sid: string,
    canonical_sid: string,
    username: string,
    domain: string,
    profile_path: string,
    status_text: string,
    health_type: int,
    loaded: bool,
    is_bak: bool,
    state_raw: string,
    anomalies: string,
}

export struct AuditLogEntry {
    timestamp: string,
    operation: string,
    target: string,
    status: string,
    status_type: int,
    details: string,
}

export global AppStrings {
    in-out property <string> window-title;
    in-out property <string> app-title;
    in-out property <string> app-subtitle;
    in-out property <string> app-version;
    in-out property <string> app-license;
    in-out property <string> nav-dashboard;
    in-out property <string> nav-repair;
    in-out property <string> nav-migration;
    in-out property <string> nav-maintenance;
    in-out property <string> nav-logs;
    in-out property <string> elevated;
    in-out property <string> unelevated;
    in-out property <string> scan;
    in-out property <string> total;
    in-out property <string> healthy;
    in-out property <string> corrupted;
    in-out property <string> temporary;
    in-out property <string> column-account;
    in-out property <string> column-sid;
    in-out property <string> column-path;
    in-out property <string> column-status;
    in-out property <string> column-loaded;
    in-out property <string> column-action;
    in-out property <string> select;
    in-out property <string> yes;
    in-out property <string> no;
    in-out property <string> no-profiles;
    in-out property <string> repair-title;
    in-out property <string> target-account;
    in-out property <string> target-sid;
    in-out property <string> profile-path;
    in-out property <string> anomalies;
    in-out property <string> none-selected;
    in-out property <string> loaded-warning;
    in-out property <string> repair-pipeline;
    in-out property <string> fix-bak;
    in-out property <string> reset-state;
    in-out property <string> unlock-hive;
    in-out property <string> dry-run;
    in-out property <string> execute-repair;
    in-out property <string> migration-title;
    in-out property <string> migration-warning;
    in-out property <string> migration-source;
    in-out property <string> migration-target;
    in-out property <string> migration-placeholder;
    in-out property <string> include-roaming;
    in-out property <string> include-docs;
    in-out property <string> start-migration;
    in-out property <string> cancel-migration;
    in-out property <string> maintenance-title;
    in-out property <string> maintenance-description;
    in-out property <string> launch-ti;
    in-out property <string> audit-title;
    in-out property <string> clear-audit;
    in-out property <string> export-audit;
    in-out property <string> audit-timestamp;
    in-out property <string> audit-operation;
    in-out property <string> audit-target;
    in-out property <string> audit-result;
    in-out property <string> audit-details;
    in-out property <string> confirm;
    in-out property <string> cancel;
}

component StatCard inherits Rectangle {
    in property <string> card-title;
    in property <string> value;
    in property <color> accent-color;
    background: DraculaTheme.card-bg;
    border-radius: DraculaTheme.border-radius;
    border-width: 1px;
    border-color: DraculaTheme.card-border;

    VerticalLayout {
        padding: DraculaTheme.spacing-md;
        spacing: 4px;
        Text { text: root.card-title; color: DraculaTheme.text-secondary; font-size: 12px; }
        Text { text: root.value; color: root.accent-color; font-size: 23px; font-weight: 700; }
    }
}

export component MainWindow inherits Window {
    title: AppStrings.window-title;
    min-width: 1040px;
    min-height: 720px;
    preferred-width: 1180px;
    preferred-height: 780px;
    background: DraculaTheme.background;
    default-font-family: DraculaTheme.font-family;

    in-out property <int> active-tab: 0;
    in-out property <string> status-message;
    in-out property <bool> is-elevated: false;
    in-out property <bool> operation-busy: false;
    in-out property <bool> migration-running: false;
    in-out property <[ProfileEntry]> profiles: [];
    in-out property <[AuditLogEntry]> audit-entries: [];
    in-out property <int> total-profiles-count: 0;
    in-out property <int> healthy-count: 0;
    in-out property <int> corrupted-count: 0;
    in-out property <int> temp-count: 0;
    in-out property <int> selected-idx: -1;
    in-out property <string> selected-sid;
    in-out property <string> selected-path;
    in-out property <string> selected-username;
    in-out property <string> selected-anomalies;
    in-out property <bool> selected-loaded: false;
    in-out property <bool> repair-fix-bak: false;
    in-out property <bool> repair-reset-state: false;
    in-out property <bool> repair-unlock-hive: false;
    in-out property <string> migration-target-path;
    in-out property <bool> migration-include-roaming: false;
    in-out property <bool> migration-include-docs: false;
    in-out property <float> migration-progress: 0.0;
    in-out property <string> migration-status;
    in-out property <bool> confirmation-visible: false;
    in-out property <int> confirmation-kind: -1;
    in-out property <string> confirmation-title;
    in-out property <string> confirmation-message;

    callback scan-profiles();
    callback select-profile(int);
    callback execute-dry-run();
    callback request-repair();
    callback start-migration();
    callback cancel-migration();
    callback request-ti-console();
    callback confirm-action(int);
    callback export-audit-json();
    callback clear-audit-logs();

    Rectangle {
        background: DraculaTheme.background;

        VerticalLayout {
            spacing: 0;

            Rectangle {
                height: 62px;
                background: DraculaTheme.current-line;
                HorizontalLayout {
                    padding-left: DraculaTheme.spacing-lg;
                    padding-right: DraculaTheme.spacing-lg;
                    alignment: space-between;
                    VerticalLayout {
                        alignment: center;
                        Text { text: AppStrings.app-title; color: DraculaTheme.purple; font-size: 19px; font-weight: 800; }
                        Text { text: AppStrings.app-subtitle; color: DraculaTheme.text-secondary; font-size: 11px; }
                    }
                    HorizontalLayout {
                        alignment: end;
                        spacing: DraculaTheme.spacing-md;
                        Rectangle {
                            height: 30px;
                            background: root.is-elevated ? #214a38 : #512c35;
                            border-radius: 4px;
                            border-width: 1px;
                            border-color: root.is-elevated ? DraculaTheme.green : DraculaTheme.red;
                            HorizontalLayout {
                                padding-left: 10px;
                                padding-right: 10px;
                                Text {
                                    text: root.is-elevated ? AppStrings.elevated : AppStrings.unelevated;
                                    color: root.is-elevated ? DraculaTheme.green : DraculaTheme.red;
                                    font-size: 11px;
                                    font-weight: 700;
                                    vertical-alignment: center;
                                }
                            }
                        }
                        Button {
                            text: AppStrings.scan;
                            enabled: !root.operation-busy;
                            primary: true;
                            clicked => { root.scan-profiles(); }
                        }
                    }
                }
            }

            Rectangle {
                height: 48px;
                background: #21222c;
                HorizontalLayout {
                    padding-left: DraculaTheme.spacing-lg;
                    padding-right: DraculaTheme.spacing-lg;
                    spacing: DraculaTheme.spacing-sm;
                    alignment: start;
                    Button { text: AppStrings.nav-dashboard; checked: root.active-tab == 0; clicked => { root.active-tab = 0; } }
                    Button { text: AppStrings.nav-repair; checked: root.active-tab == 1; clicked => { root.active-tab = 1; } }
                    Button { text: AppStrings.nav-migration; checked: root.active-tab == 2; clicked => { root.active-tab = 2; } }
                    Button { text: AppStrings.nav-maintenance; checked: root.active-tab == 3; clicked => { root.active-tab = 3; } }
                    Button { text: AppStrings.nav-logs; checked: root.active-tab == 4; clicked => { root.active-tab = 4; } }
                }
            }

            Rectangle {
                background: DraculaTheme.background;

                if root.active-tab == 0: VerticalLayout {
                    padding: DraculaTheme.spacing-lg;
                    spacing: DraculaTheme.spacing-md;
                    HorizontalLayout {
                        spacing: DraculaTheme.spacing-md;
                        height: 82px;
                        StatCard { card-title: AppStrings.total; value: root.total-profiles-count; accent-color: DraculaTheme.cyan; }
                        StatCard { card-title: AppStrings.healthy; value: root.healthy-count; accent-color: DraculaTheme.green; }
                        StatCard { card-title: AppStrings.corrupted; value: root.corrupted-count; accent-color: DraculaTheme.orange; }
                        StatCard { card-title: AppStrings.temporary; value: root.temp-count; accent-color: DraculaTheme.red; }
                    }
                    Rectangle {
                        background: DraculaTheme.card-bg;
                        border-radius: DraculaTheme.border-radius;
                        border-width: 1px;
                        border-color: DraculaTheme.card-border;
                        VerticalLayout {
                            padding: DraculaTheme.spacing-sm;
                            spacing: 4px;
                            Rectangle {
                                height: 34px;
                                background: DraculaTheme.current-line;
                                HorizontalLayout {
                                    padding-left: 10px;
                                    padding-right: 10px;
                                    spacing: 8px;
                                    Text { text: AppStrings.column-account; color: DraculaTheme.text-secondary; font-weight: 700; width: 150px; vertical-alignment: center; }
                                    Text { text: AppStrings.column-sid; color: DraculaTheme.text-secondary; font-weight: 700; width: 220px; vertical-alignment: center; }
                                    Text { text: AppStrings.column-path; color: DraculaTheme.text-secondary; font-weight: 700; horizontal-stretch: 1; vertical-alignment: center; }
                                    Text { text: AppStrings.column-status; color: DraculaTheme.text-secondary; font-weight: 700; width: 190px; vertical-alignment: center; }
                                    Text { text: AppStrings.column-loaded; color: DraculaTheme.text-secondary; font-weight: 700; width: 58px; vertical-alignment: center; }
                                    Text { text: AppStrings.column-action; color: DraculaTheme.text-secondary; font-weight: 700; width: 90px; vertical-alignment: center; }
                                }
                            }
                            if root.profiles.length == 0: Text {
                                text: AppStrings.no-profiles;
                                color: DraculaTheme.text-secondary;
                                horizontal-alignment: center;
                                vertical-alignment: center;
                            }
                            ListView {
                                for profile[idx] in root.profiles: Rectangle {
                                    height: 44px;
                                    background: root.selected-idx == idx ? DraculaTheme.selection : transparent;
                                    border-radius: 4px;
                                    HorizontalLayout {
                                        padding-left: 10px;
                                        padding-right: 10px;
                                        spacing: 8px;
                                        Text { text: profile.username; color: DraculaTheme.foreground; font-weight: 600; width: 150px; vertical-alignment: center; overflow: elide; }
                                        Text { text: profile.sid; color: DraculaTheme.text-secondary; font-size: 11px; width: 220px; vertical-alignment: center; overflow: elide; }
                                        Text { text: profile.profile_path; color: DraculaTheme.cyan; font-size: 11px; horizontal-stretch: 1; vertical-alignment: center; overflow: elide; }
                                        Text { text: profile.status_text; color: profile.health_type == 0 ? DraculaTheme.green : (profile.health_type == 1 ? DraculaTheme.orange : DraculaTheme.red); font-weight: 600; width: 190px; vertical-alignment: center; overflow: elide; }
                                        Text { text: profile.loaded ? AppStrings.yes : AppStrings.no; color: profile.loaded ? DraculaTheme.yellow : DraculaTheme.text-secondary; width: 58px; vertical-alignment: center; }
                                        Button { text: AppStrings.select; width: 90px; enabled: !root.operation-busy; clicked => { root.select-profile(idx); } }
                                    }
                                }
                            }
                        }
                    }
                }

                if root.active-tab == 1: VerticalLayout {
                    padding: DraculaTheme.spacing-lg;
                    spacing: DraculaTheme.spacing-md;
                    Rectangle {
                        background: DraculaTheme.card-bg;
                        border-radius: DraculaTheme.border-radius;
                        border-width: 1px;
                        border-color: DraculaTheme.card-border;
                        VerticalLayout {
                            padding: DraculaTheme.spacing-lg;
                            spacing: DraculaTheme.spacing-md;
                            Text { text: AppStrings.repair-title; color: DraculaTheme.purple; font-size: 17px; font-weight: 700; }
                            Rectangle {
                                background: DraculaTheme.current-line;
                                border-radius: 6px;
                                VerticalLayout {
                                    padding: 10px;
                                    spacing: 4px;
                                    Text { text: AppStrings.target-account + " " + (root.selected-username != "" ? root.selected-username : AppStrings.none-selected); color: DraculaTheme.foreground; font-weight: 700; }
                                    Text { text: AppStrings.target-sid + " " + root.selected-sid; color: DraculaTheme.text-secondary; font-size: 11px; }
                                    Text { text: AppStrings.profile-path + " " + root.selected-path; color: DraculaTheme.cyan; font-size: 11px; }
                                    if root.selected-anomalies != "": Text { text: AppStrings.anomalies + " " + root.selected-anomalies; color: DraculaTheme.orange; font-weight: 600; }
                                    if root.selected-loaded: Text { text: AppStrings.loaded-warning; color: DraculaTheme.red; font-weight: 700; }
                                }
                            }
                            Text { text: AppStrings.repair-pipeline; color: DraculaTheme.text-secondary; font-size: 12px; wrap: word-wrap; }
                            CheckBox { text: AppStrings.fix-bak; checked <=> root.repair-fix-bak; enabled: !root.operation-busy; }
                            CheckBox { text: AppStrings.reset-state; checked <=> root.repair-reset-state; enabled: !root.operation-busy; }
                            CheckBox { text: AppStrings.unlock-hive; checked <=> root.repair-unlock-hive; enabled: !root.operation-busy; }
                            HorizontalLayout {
                                spacing: DraculaTheme.spacing-md;
                                Button {
                                    text: AppStrings.dry-run;
                                    enabled: root.is-elevated && !root.operation-busy && root.selected-sid != "" && !root.selected-loaded;
                                    clicked => { root.execute-dry-run(); }
                                }
                                Button {
                                    text: AppStrings.execute-repair;
                                    primary: true;
                                    enabled: root.is-elevated && !root.operation-busy && root.selected-sid != "" && !root.selected-loaded;
                                    clicked => { root.request-repair(); }
                                }
                            }
                        }
                    }
                }

                if root.active-tab == 2: VerticalLayout {
                    padding: DraculaTheme.spacing-lg;
                    spacing: DraculaTheme.spacing-md;
                    Rectangle {
                        background: DraculaTheme.card-bg;
                        border-radius: DraculaTheme.border-radius;
                        border-width: 1px;
                        border-color: DraculaTheme.card-border;
                        VerticalLayout {
                            padding: DraculaTheme.spacing-lg;
                            spacing: DraculaTheme.spacing-md;
                            Text { text: AppStrings.migration-title; color: DraculaTheme.cyan; font-size: 17px; font-weight: 700; }
                            Rectangle {
                                background: #4a3d2a;
                                border-radius: 6px;
                                VerticalLayout {
                                    padding: 12px;
                                    Text { text: AppStrings.migration-warning; color: DraculaTheme.yellow; wrap: word-wrap; }
                                }
                            }
                            Text { text: AppStrings.migration-source + " " + root.selected-path; color: DraculaTheme.foreground; font-weight: 600; }
                            HorizontalLayout {
                                spacing: DraculaTheme.spacing-md;
                                Text { text: AppStrings.migration-target; color: DraculaTheme.text-secondary; vertical-alignment: center; }
                                LineEdit {
                                    text <=> root.migration-target-path;
                                    placeholder-text: AppStrings.migration-placeholder;
                                    accessible-label: AppStrings.migration-target;
                                    enabled: !root.operation-busy;
                                    horizontal-stretch: 1;
                                }
                            }
                            CheckBox { text: AppStrings.include-roaming; checked <=> root.migration-include-roaming; enabled: !root.operation-busy; }
                            CheckBox { text: AppStrings.include-docs; checked <=> root.migration-include-docs; enabled: !root.operation-busy; }
                            Text { text: root.migration-status; color: DraculaTheme.text-secondary; font-weight: 600; }
                            ProgressIndicator { progress: root.migration-progress; height: 14px; }
                            HorizontalLayout {
                                spacing: DraculaTheme.spacing-md;
                                Button {
                                    text: AppStrings.start-migration;
                                    primary: true;
                                    enabled: root.is-elevated && !root.operation-busy && root.selected-path != "" && root.migration-target-path != "" && (root.migration-include-roaming || root.migration-include-docs);
                                    clicked => { root.start-migration(); }
                                }
                                Button {
                                    text: AppStrings.cancel-migration;
                                    enabled: root.migration-running;
                                    clicked => { root.cancel-migration(); }
                                }
                            }
                        }
                    }
                }

                if root.active-tab == 3: VerticalLayout {
                    padding: DraculaTheme.spacing-lg;
                    spacing: DraculaTheme.spacing-md;
                    Rectangle {
                        background: DraculaTheme.card-bg;
                        border-radius: DraculaTheme.border-radius;
                        border-width: 1px;
                        border-color: DraculaTheme.card-border;
                        VerticalLayout {
                            padding: DraculaTheme.spacing-lg;
                            spacing: DraculaTheme.spacing-md;
                            Text { text: AppStrings.maintenance-title; color: DraculaTheme.pink; font-size: 17px; font-weight: 700; }
                            Text { text: AppStrings.maintenance-description; color: DraculaTheme.text-secondary; wrap: word-wrap; }
                            Button {
                                text: AppStrings.launch-ti;
                                primary: true;
                                enabled: root.is-elevated && !root.operation-busy;
                                clicked => { root.request-ti-console(); }
                            }
                        }
                    }
                }

                if root.active-tab == 4: VerticalLayout {
                    padding: DraculaTheme.spacing-lg;
                    spacing: DraculaTheme.spacing-md;
                    HorizontalLayout {
                        alignment: space-between;
                        Text { text: AppStrings.audit-title; color: DraculaTheme.yellow; font-size: 17px; font-weight: 700; vertical-alignment: center; }
                        HorizontalLayout {
                            spacing: DraculaTheme.spacing-sm;
                            Button { text: AppStrings.clear-audit; enabled: !root.operation-busy; clicked => { root.clear-audit-logs(); } }
                            Button { text: AppStrings.export-audit; enabled: !root.operation-busy; clicked => { root.export-audit-json(); } }
                        }
                    }
                    Rectangle {
                        background: DraculaTheme.card-bg;
                        border-radius: DraculaTheme.border-radius;
                        border-width: 1px;
                        border-color: DraculaTheme.card-border;
                        VerticalLayout {
                            padding: DraculaTheme.spacing-sm;
                            spacing: 4px;
                            Rectangle {
                                height: 34px;
                                background: DraculaTheme.current-line;
                                HorizontalLayout {
                                    padding-left: 10px;
                                    padding-right: 10px;
                                    spacing: 8px;
                                    Text { text: AppStrings.audit-timestamp; color: DraculaTheme.text-secondary; font-weight: 700; width: 150px; vertical-alignment: center; }
                                    Text { text: AppStrings.audit-operation; color: DraculaTheme.text-secondary; font-weight: 700; width: 150px; vertical-alignment: center; }
                                    Text { text: AppStrings.audit-target; color: DraculaTheme.text-secondary; font-weight: 700; width: 180px; vertical-alignment: center; }
                                    Text { text: AppStrings.audit-result; color: DraculaTheme.text-secondary; font-weight: 700; width: 100px; vertical-alignment: center; }
                                    Text { text: AppStrings.audit-details; color: DraculaTheme.text-secondary; font-weight: 700; horizontal-stretch: 1; vertical-alignment: center; }
                                }
                            }
                            ListView {
                                for entry in root.audit-entries: Rectangle {
                                    height: 38px;
                                    background: DraculaTheme.current-line;
                                    border-radius: 4px;
                                    HorizontalLayout {
                                        padding-left: 10px;
                                        padding-right: 10px;
                                        spacing: 8px;
                                        Text { text: entry.timestamp; color: DraculaTheme.text-secondary; font-size: 11px; width: 150px; vertical-alignment: center; }
                                        Text { text: entry.operation; color: DraculaTheme.purple; font-weight: 600; width: 150px; vertical-alignment: center; overflow: elide; }
                                        Text { text: entry.target; color: DraculaTheme.cyan; font-size: 11px; width: 180px; vertical-alignment: center; overflow: elide; }
                                        Text { text: entry.status; color: entry.status_type == 0 ? DraculaTheme.green : (entry.status_type == 1 ? DraculaTheme.orange : DraculaTheme.red); font-weight: 700; width: 100px; vertical-alignment: center; }
                                        Text { text: entry.details; color: DraculaTheme.foreground; font-size: 11px; horizontal-stretch: 1; vertical-alignment: center; overflow: elide; }
                                    }
                                }
                            }
                        }
                    }
                }
            }

            Rectangle {
                height: 32px;
                background: DraculaTheme.current-line;
                HorizontalLayout {
                    padding-left: DraculaTheme.spacing-lg;
                    padding-right: DraculaTheme.spacing-lg;
                    alignment: space-between;
                    Text { text: root.status-message; color: DraculaTheme.foreground; font-size: 11px; vertical-alignment: center; overflow: elide; }
                    Text { text: AppStrings.app-version + " | " + AppStrings.app-license; color: DraculaTheme.text-secondary; font-size: 11px; vertical-alignment: center; }
                }
            }
        }

        if root.confirmation-visible: Rectangle {
            background: #aa000000;
            VerticalLayout {
                alignment: center;
                Rectangle {
                    width: 580px;
                    height: 260px;
                    background: DraculaTheme.card-bg;
                    border-radius: DraculaTheme.border-radius;
                    border-width: 2px;
                    border-color: DraculaTheme.orange;
                    VerticalLayout {
                        padding: DraculaTheme.spacing-lg;
                        spacing: DraculaTheme.spacing-md;
                        Text { text: root.confirmation-title; color: DraculaTheme.orange; font-size: 18px; font-weight: 700; }
                        Text { text: root.confirmation-message; color: DraculaTheme.foreground; wrap: word-wrap; vertical-stretch: 1; }
                        HorizontalLayout {
                            alignment: end;
                            spacing: DraculaTheme.spacing-md;
                            Button { text: AppStrings.cancel; clicked => { root.confirmation-visible = false; root.confirmation-kind = -1; } }
                            Button {
                                text: AppStrings.confirm;
                                primary: true;
                                clicked => {
                                    root.confirmation-visible = false;
                                    root.confirm-action(root.confirmation-kind);
                                    root.confirmation-kind = -1;
                                }
                            }
                        }
                    }
                }
            }
        }
    }
}
