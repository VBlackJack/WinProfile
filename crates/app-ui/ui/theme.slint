export global DraculaTheme {
    // Dracula Palette
    out property <color> background: #282a36;
    out property <color> current-line: #44475a;
    out property <color> selection: #44475a;
    out property <color> foreground: #f8f8f2;
    out property <color> comment: #aeb9df;
    out property <color> cyan: #8be9fd;
    out property <color> green: #50fa7b;
    out property <color> orange: #ffb86c;
    out property <color> pink: #ff95d1;
    out property <color> purple: #caa9fa;
    out property <color> red: #ff9a9a;
    out property <color> yellow: #f1fa8c;

    // Semantic colors
    out property <color> card-bg: #343746;
    out property <color> card-border: #44475a;
    out property <color> text-primary: #f8f8f2;
    out property <color> text-secondary: #aeb9df;
    out property <color> text-muted: #aeb9df;
    out property <color> success: #50fa7b;
    out property <color> warning: #ffb86c;
    out property <color> error: #ff9a9a;
    out property <color> accent: #caa9fa;
    out property <color> accent-hover: #caa9fa;

    // Typography & Metrics
    out property <string> font-family: "Segoe UI";
    out property <length> border-radius: 8px;
    out property <length> spacing-sm: 6px;
    out property <length> spacing-md: 12px;
    out property <length> spacing-lg: 20px;
}
